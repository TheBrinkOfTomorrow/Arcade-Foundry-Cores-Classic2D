+// Out Run board oracle (ORTRACE_LOG): one line per screen update with both
+// 68000s' instruction counts and hashes of the indexed and RGB screen;
+// ORTRACE_REPLAY: a text file of "UPDATE PORT VALUE" lines (PORT: service,
+// unknown, coinage, dsw, adc0, adc1, adc2; VALUE hex). After the native
+// core's screen update UPDATE (MAME's UPDATE+1, which counts an extra
+// power-on update) the port reads VALUE from then on.
+static int g_or_in[7] = { -1, -1, -1, -1, -1, -1, -1 };
+struct or_replay_ev { u64 update; int port; int value; };
+static std::vector<or_replay_ev> g_or_replay;
+static size_t g_or_replay_pos = 0;
+static void ortrace_replay_load()
+{
+	const char *path = getenv("ORTRACE_REPLAY");
+	if (!path) return;
+	FILE *f = fopen(path, "r");
+	if (!f) return;
+	static const char *const names[7] = { "service", "unknown", "coinage", "dsw", "adc0", "adc1", "adc2" };
+	char line[256];
+	while (fgets(line, sizeof line, f))
+	{
+		unsigned long long u; char name[32]; unsigned v;
+		if (line[0] == '#' || sscanf(line, "%llu %31s %x", &u, name, &v) != 3) continue;
+		for (int i = 0; i < 7; i++)
+			if (!strcmp(name, names[i])) g_or_replay.push_back({ u, i, int(v & 0xff) });
+	}
+	fclose(f);
+}
+
+// ORTRACE_FBDUMP_DIR / ORTRACE_FBDUMP_EVERY dump raw RGB frames.
+static void ortrace_frame(running_machine &machine, m68000_device &main, m68000_device &sub, z80_device &snd, palette_device &palette, bitmap_ind16 &bitmap)
+{
+	static u64 frame = 0;
+	static bool init = false;
+	static const char *dir = nullptr;
+	static u64 every = 1;
+	if (!init)
+	{
+		init = true;
+		dir = getenv("ORTRACE_FBDUMP_DIR");
+		if (const char *e = getenv("ORTRACE_FBDUMP_EVERY")) every = strtoull(e, nullptr, 10);
+		if (!every) every = 1;
+		ortrace_replay_load();
+	}
+	if (g_ortrace_log || dir)
+	{
+		u64 hi = 1469598103934665603ULL, hr = 1469598103934665603ULL;
+		std::vector<u8> rgb;
+		if (dir && !(frame % every)) rgb.reserve(320 * 224 * 3);
+		
+		for (int y = 0; y < 224; y++)
+		{
+			u16 const *row = &bitmap.pix(y);
+			for (int x = 0; x < 320; x++)
+			{
+				hi = (hi ^ row[x]) * 1099511628211ULL;
+				rgb_t const c = palette.pen_color(row[x]);
+				hr = (hr ^ (c & 0xffffff)) * 1099511628211ULL;
+				if (dir && !(frame % every)) { rgb.push_back(c.r()); rgb.push_back(c.g()); rgb.push_back(c.b()); }
+			}
+		}
+		if (g_ortrace_log)
+			fprintf(g_ortrace_log, "f %llu %llu %llu %llu %016llx %016llx\n", (unsigned long long)frame, (unsigned long long)main.or_insn(),
+					(unsigned long long)sub.or_insn(), (unsigned long long)snd.total_cycles(), (unsigned long long)hi, (unsigned long long)hr);
+		if (dir && !(frame % every))
+		{
+			char path[1024];
+			snprintf(path, sizeof path, "%s/f%06llu.rgb", dir, (unsigned long long)frame);
+			if (FILE *f = fopen(path, "wb")) { fwrite(rgb.data(), 1, rgb.size(), f); fclose(f); }
+		}
+	}
+	while (g_or_replay_pos < g_or_replay.size() && g_or_replay[g_or_replay_pos].update + 1 <= frame)
+	{
+		g_or_in[g_or_replay[g_or_replay_pos].port] = g_or_replay[g_or_replay_pos].value;
+		g_or_replay_pos++;
+	}
+	frame++;
+}
