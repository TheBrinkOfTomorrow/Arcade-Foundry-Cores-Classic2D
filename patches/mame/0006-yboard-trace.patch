+// Y Board oracle (ORTRACE_LOG, ORTRACE_PCS, ORTRACE_EVERY): the three
+// 68000s' instruction counts, interrupts and register snapshots, in the
+// format of m68000_device's Out Run board trace (0001-outrun-trace.patch)
+extern FILE *g_ortrace_log;
+static bool g_msh_tried = false;
+static std::set<u32> g_msh_pcs[3];
+static const char *g_msh_pcs_path = nullptr;
+static u64 g_msh_mask = 4095;
+
+int m68000_musashi_device::ortrace_id() const
+{
+	if(!g_msh_tried) {
+		g_msh_tried = true;
+		if(!g_ortrace_log) if(const char *p = getenv("ORTRACE_LOG")) g_ortrace_log = fopen(p, "w");
+		g_msh_pcs_path = getenv("ORTRACE_PCS");
+		if(const char *e = getenv("ORTRACE_EVERY")) g_msh_mask = strtoull(e, nullptr, 10) - 1; // a power of two
+	}
+	const std::string t(tag());
+	if(t == ":maincpu") return 0;
+	if(t == ":subx") return 1;
+	if(t == ":suby") return 2;
+	return -1;
+}
+
+void ortrace_msh_write_pcs()
+{
+	if(!g_msh_pcs_path) return;
+	static const char *const names[3] = { ".main", ".subx", ".suby" };
+	for(int c = 0; c < 3; c++) {
+		if(g_msh_pcs[c].empty()) continue;
+		std::string p = std::string(g_msh_pcs_path) + names[c];
+		if(FILE *f = fopen(p.c_str(), "w")) {
+			for(u32 a : g_msh_pcs[c]) fprintf(f, "%06x\n", a);
+			fclose(f);
+		}
+	}
+}
