+	m_iochip[1]->in_porta_cb().set([this] () -> u8 { return g_xb_in[1] >= 0 ? u8(g_xb_in[1]) : u8(ioport("IO1PORTA")->read()); });
+	m_iochip[1]->in_portb_cb().set([this] () -> u8 { return g_xb_in[2] >= 0 ? u8(g_xb_in[2]) : u8(ioport("IO1PORTB")->read()); });
+	m_iochip[1]->in_portc_cb().set([this] () -> u8 { return g_xb_in[3] >= 0 ? u8(g_xb_in[3]) : u8(ioport("IO1PORTC")->read()); });
+	m_iochip[1]->in_portd_cb().set([this] () -> u8 { return g_xb_in[4] >= 0 ? u8(g_xb_in[4]) : u8(ioport("IO1PORTD")->read()); });
 
 	adc0804_device &adc(ADC0804(config, "adc", MASTER_CLOCK/4/10)); // uses E clock from main CPU
