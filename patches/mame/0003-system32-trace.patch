+// Classic 2D cores oracle (M1TRACE_FRAMES): one line per screen update of
+// screen 0: frame, V60/V70 instructions, Z80 cycles, hash of the RGB pixels
+void segas32_state::trace_frame(bitmap_rgb32 &bitmap, const rectangle &cliprect)
+{
+	{
+		static FILE *f = nullptr;
+		static bool init = false;
+		static uint64_t frame = 0;
+		if (!init)
+		{
+			init = true;
+			if (const char *p = getenv("M1TRACE_FRAMES")) f = fopen(p, "w");
+		}
+		if (f)
+		{
+			uint64_t h = 1469598103934665603ULL;
+			for (int y = cliprect.min_y; y <= cliprect.max_y; y++)
+				for (int x = cliprect.min_x; x <= cliprect.max_x; x++)
+					h = (h ^ (bitmap.pix(y, x) & 0xffffff)) * 1099511628211ULL;
+			fprintf(f, "f %llu %llu %llu %d-%d %016llx\n", (unsigned long long)frame++, (unsigned long long)m_maincpu->trace_insn_count(),
+					(unsigned long long)m_soundcpu->total_cycles(), cliprect.min_x, cliprect.max_x, (unsigned long long)h);
+			fflush(f);
+			// M1TRACE_DUMP=DIR writes every frame as DIR/f<frame>.ppm
+			if (const char *d = getenv("M1TRACE_DUMP"))
+			{
+				char name[512];
+				snprintf(name, sizeof(name), "%s/f%llu.ppm", d, (unsigned long long)(frame - 1));
+				if (FILE *o = fopen(name, "wb"))
+				{
+					fprintf(o, "P6 %d %d 255\n", cliprect.max_x - cliprect.min_x + 1, cliprect.max_y - cliprect.min_y + 1);
+					for (int y = cliprect.min_y; y <= cliprect.max_y; y++)
+						for (int x = cliprect.min_x; x <= cliprect.max_x; x++)
+						{
+							uint32_t c = bitmap.pix(y, x);
+							fputc((c >> 16) & 0xff, o); fputc((c >> 8) & 0xff, o); fputc(c & 0xff, o);
+						}
+					fclose(o);
+				}
+			}
+		}
+	}
+}
