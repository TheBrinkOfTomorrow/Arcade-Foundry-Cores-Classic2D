@@ -194,7 +197,94 @@ void segahang_state::video_start()
 //  screen_update - render all graphics
 //-------------------------------------------------
 
+// Hang-On board oracle (ORTRACE_LOG): one line per screen update with both
+// 68000s' instruction counts and hashes of the indexed and RGB screen;
+// ORTRACE_REPLAY: "UPDATE PORT VALUE" lines (PORT: service, coinage, dsw,
+// unknown, adc0-adc3; VALUE hex), applied after the native core's screen
+// update UPDATE (MAME's UPDATE+1). ORTRACE_FBDUMP_DIR/_EVERY dump RGB frames.
+static int g_hang_in[8] = { -1, -1, -1, -1, -1, -1, -1, -1 };
+struct hang_replay_ev { u64 update; int port; int value; };
+static std::vector<hang_replay_ev> g_hang_replay;
+static size_t g_hang_replay_pos = 0;
+static void hangtrace_replay_load()
+{
+	const char *path = getenv("ORTRACE_REPLAY");
+	if (!path) return;
+	FILE *f = fopen(path, "r");
+	if (!f) return;
+	static const char *const names[8] = { "service", "coinage", "dsw", "unknown", "adc0", "adc1", "adc2", "adc3" };
+	char line[256];
+	while (fgets(line, sizeof line, f))
+	{
+		unsigned long long u; char name[32]; unsigned v;
+		if (line[0] == '#' || sscanf(line, "%llu %31s %x", &u, name, &v) != 3) continue;
+		for (int i = 0; i < 8; i++)
+			if (!strcmp(name, names[i])) g_hang_replay.push_back({ u, i, int(v & 0xff) });
+	}
+	fclose(f);
+}
+
+static void hangtrace_frame(m68000_device &main, m68000_device &sub, z80_device &snd, palette_device &palette, bitmap_ind16 &bitmap, const rectangle &clip)
+{
+	static const bool hash_clip = getenv("ORTRACE_HASH_CLIP") != nullptr;
+	static u64 frame = 0;
+	static bool init = false;
+	static const char *dir = nullptr;
+	static u64 every = 1;
+	if (!init)
+	{
+		init = true;
+		dir = getenv("ORTRACE_FBDUMP_DIR");
+		if (const char *e = getenv("ORTRACE_FBDUMP_EVERY")) every = strtoull(e, nullptr, 10);
+		if (!every) every = 1;
+		hangtrace_replay_load();
+	}
+	if (g_ortrace_log || dir)
+	{
+		u64 hi = 1469598103934665603ULL, hr = 1469598103934665603ULL;
+		std::vector<u8> rgb;
+		if (dir && !(frame % every)) rgb.reserve(320 * 224 * 3);
+		for (int y = 0; y < 224; y++)
+		{
+			const bool hash_row = !hash_clip || (y >= clip.min_y && y <= clip.max_y);
+			u16 const *row = &bitmap.pix(y);
+			for (int x = 0; x < 320; x++)
+			{
+				rgb_t const c = palette.pen_color(row[x]);
+				if (hash_row)
+				{
+					hi = (hi ^ row[x]) * 1099511628211ULL;
+					hr = (hr ^ (c & 0xffffff)) * 1099511628211ULL;
+				}
+				if (dir && !(frame % every)) { rgb.push_back(c.r()); rgb.push_back(c.g()); rgb.push_back(c.b()); }
+			}
+		}
+		if (g_ortrace_log)
+			fprintf(g_ortrace_log, "f %llu %llu %llu %llu %016llx %016llx %d %d\n", (unsigned long long)frame, (unsigned long long)main.or_insn(),
+					(unsigned long long)sub.or_insn(), (unsigned long long)snd.total_cycles(), (unsigned long long)hi, (unsigned long long)hr, clip.min_y, clip.max_y);
+		if (dir && !(frame % every))
+		{
+			char path[1024];
+			snprintf(path, sizeof path, "%s/f%06llu.rgb", dir, (unsigned long long)frame);
+			if (FILE *f = fopen(path, "wb")) { fwrite(rgb.data(), 1, rgb.size(), f); fclose(f); }
+		}
+	}
+	while (g_hang_replay_pos < g_hang_replay.size() && g_hang_replay[g_hang_replay_pos].update + 1 <= frame)
+	{
+		g_hang_in[g_hang_replay[g_hang_replay_pos].port] = g_hang_replay[g_hang_replay_pos].value;
+		g_hang_replay_pos++;
+	}
+	frame++;
+}
+
 uint32_t segahang_state::screen_update(screen_device &screen, bitmap_ind16 &bitmap, const rectangle &cliprect)
+{
+	uint32_t const r = screen_update_draw(screen, bitmap, cliprect);
+	hangtrace_frame(*m_maincpu, *m_subcpu, *m_soundcpu, *m_palette, bitmap, cliprect);
+	return r;
+}
